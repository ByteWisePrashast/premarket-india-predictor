# Optional but recommended. Get a free key from https://newsapi.org/
NEWSAPI_KEY=

# GIFT Nifty is not reliably exposed through one free API.
# Option 1: provide a JSON/HTML endpoint whose payload contains an LTP-like field.
GIFT_NIFTY_URL=

# Option 2: provide one or more yfinance symbols if your data vendor exposes them.
# The script tries them in order.
GIFT_NIFTY_SYMBOLS=

# Manual fallback for institutional data if NSE blocks/rate-limits the API.
# Values should be in INR crore, positive for net buying and negative for net selling.
FII_NET_CASH_CR=
DII_NET_CASH_CR=
